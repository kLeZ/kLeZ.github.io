@startuml
!include ../guide/_common.iuml
left to right direction
actor "Io" as me
rectangle "Claude Code\n(un programma a riga di comando)" as cc
rectangle "shell" as sh
rectangle "cat, sed, grep, find" as unix
rectangle "git, glab, gh" as vcs
rectangle "curl, jq" as web
rectangle "emacsclient --eval" as ec
rectangle "Emacs già acceso\n(i miei task in Org)" as emacs
me --> cc : "fammi questa cosa"
cc --> sh : tab-return
sh --> unix
sh --> vcs
sh --> web
sh --> ec
ec --> emacs
@enduml
