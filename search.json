---
# Search index for /cerca/ (assets/search.js): one entry per post of the page's
# language list (site.data.i18n.posts, _plugins/i18n.rb). `localize: true`
# builds /search.json and /en/search.json.
layout: null
permalink: /search.json
sitemap: false
localize: true
---
[
{%- for post in site.data.i18n.posts[page.lang] %}
{"id":{{ forloop.index0 }},"url":{{ post.url | prepend: site.baseurl | jsonify }},"lang":{{ post.lang | jsonify }},"title":{{ post.title | plain_text | jsonify }},"date":{{ post.date | date_to_xmlschema | jsonify }},"tags":[{%- for tag in post.tags -%}{"name":{{ tag | jsonify }},"slug":{{ tag | tag_slug | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"excerpt":{{ post.excerpt | plain_text | truncate: 280 | jsonify }},"content":{{ post.content | plain_text | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
