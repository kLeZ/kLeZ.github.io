---
# Search index for /cerca/ (assets/search.js). One entry per post of the active
# language; polyglot builds /search.json and /en/search.json.
layout: null
permalink: /search.json
sitemap: false
---
{%- include lang-prefix.html -%}
[
{%- for post in site.posts %}
{"id":{{ forloop.index0 }},"url":{{ post.url | prepend: lang_prefix | prepend: site.baseurl | jsonify }},"title":{{ post.title | plain_text | jsonify }},"date":{{ post.date | date_to_xmlschema | jsonify }},"tags":[{%- for tag in post.tags -%}{"name":{{ tag | jsonify }},"slug":{{ tag | tag_slug | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],"excerpt":{{ post.excerpt | plain_text | truncate: 280 | jsonify }},"content":{{ post.content | plain_text | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
