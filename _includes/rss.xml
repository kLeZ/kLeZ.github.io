{%- comment -%}
Feed RSS 2.0 (https://www.rssboard.org/rss-specification), accanto ad Atom
(_includes/atom.xml) per i lettori che leggono solo RSS. Stessi post e stesso limite.
Parametri: lang = codice di una lingua | vuoto (tutte le lingue, ogni versione di
ogni post). I feed per lingua (/<lingua>/rss.xml) li genera _plugins/i18n.rb.
RSS non ha una lingua per voce: quella di ogni post va in dc:language.
{%- endcomment -%}
{%- assign loc = site.data.locales[page.lang] | default: site.data.locales[site.default_lang] -%}
{%- if include.lang -%}
{%- assign feed_posts = site.posts | where: "lang", include.lang -%}
{%- assign feed_lang_name = include.lang | language_name: page.lang -%}
{%- assign feed_title = loc.feed_lang | replace: '%s', feed_lang_name -%}
{%- else -%}
{%- assign feed_posts = site.posts -%}
{%- assign feed_title = loc.feed_all -%}
{%- endif -%}
{%- assign feed_posts = feed_posts | slice: 0, site.feed_posts_limit -%}
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/">
	<channel>
		<title>{{ site.data.author.name | xml_escape }} &#8211; {{ feed_title | xml_escape }}</title>
		<link>{{ '/' | i18n_url: include.lang | absolute_url }}</link>
		<description>{{ site.description | xml_escape }}</description>
		{%- if include.lang %}
		<language>{{ include.lang }}</language>
		{%- endif %}
		<copyright>{{ site.copyright | xml_escape }}</copyright>
		<lastBuildDate>{{ site.time | date_to_rfc822 }}</lastBuildDate>
		<generator>Jekyll {{ jekyll.version }}</generator>
		<atom:link href="{{ page.url | absolute_url }}" rel="self" type="application/rss+xml" />
		{%- for post in feed_posts %}
		<item>
			<title>{{ post.title | xml_escape }}</title>
			<link>{{ post.url | absolute_url }}</link>
			<guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
			<pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
			<dc:creator>{{ post.author.name | default: site.data.author.name | xml_escape }}</dc:creator>
			<dc:language>{{ post.lang }}</dc:language>
			{%- for tag in post.tags %}
			<category>{{ tag | xml_escape }}</category>
			{%- endfor %}
			<description>{{ post.excerpt | strip_html | normalize_whitespace | xml_escape }}</description>
			<content:encoded>{{ post.content | xml_escape }}</content:encoded>
		</item>
		{%- endfor %}
	</channel>
</rss>
