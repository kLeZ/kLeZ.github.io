#!/usr/bin/env bash
# Usage: translate [-n] [-f] [-t LANG] FILE...
# Translates each FILE into every other language in `languages:` (_config.yml), or only
# into LANG. The source language is the file's language folder (_posts/en/x.md is
# English), otherwise the site's default language. An English file written at the root
# with `lang: en` is first moved (git mv) into its language folder.
#   -n  dry run: print what would be translated or skipped, call no model
#   -f  translate again even if the source has not changed since the last translation
# Environment:
#   TRANSLATE_ADAPTER  which _scripts/i18n/translate-<adapter> calls the model: openrouter
#                      (default), claude, replay; each adapter documents its own variables
#
# Each translation goes through small programs in _scripts/i18n/, all reading and
# writing files or stdin/stdout:
#   prep TGT        links to the TGT versions, quotes whose original is already in TGT
#   translate-*     the model (the prompt comes from `prompt SRC TGT`)
#   clean           ASCII punctuation, no fence around the reply, one final newline
#   assemble        source front matter + translated fields + source_sha, translated body
#   check           structure and numbers against the source; problems mark the file
#                   with `translation_review: true`
#
# A file with `source_sha` is a translation: it is regenerated when its source changes.
# A file without it is an original and is never overwritten, not even with -f.
set -euo pipefail

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

dry=0 force=0 only=""
while getopts nft: opt; do
    case $opt in
        n) dry=1 ;;
        f) force=1 ;;
        t) only=$OPTARG ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
(( $# )) || usage

root=$(cd "$(dirname "$0")/.." && pwd)
i18n=$root/_scripts/i18n
adapter=$i18n/translate-${TRANSLATE_ADAPTER:-openrouter}
[[ -x $adapter ]] || { echo "translate: no adapter $adapter" >&2; exit 2; }
files=()
for f in "$@"; do
    [[ -f $f ]] || { echo "translate: $f: no such file" >&2; exit 2; }
    files+=("$(realpath --relative-to="$root" "$f")")
done
cd "$root"
mapfile -t langs < <(yq '.languages[]' _config.yml)
default=$(yq '.default_lang // .languages[0]' _config.yml)
[[ -z $only || " ${langs[*]} " == *" $only "* ]] || { echo "translate: $only is not in languages: ${langs[*]}" >&2; exit 2; }
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

is_lang() { [[ " ${langs[*]} " == *" $1 "* ]]; }
has_front_matter() { [[ $(head -n 1 "$1") == --- ]]; }

# language folder right below the top folder (_posts/en/x.md), empty if none
lang_folder() {
    local rest=${1#*/} first
    [[ $rest == */* ]] || return 0
    first=${rest%%/*}
    if is_lang "$first" && [[ $first != "$default" ]]; then echo "$first"; fi
}

target_path() {
    local rel=$1 tgt=$2 top rest
    top=${rel%%/*} rest=${rel#*/}
    [[ -n $(lang_folder "$rel") ]] && rest=${rest#*/}
    if [[ $tgt == "$default" ]]; then echo "$top/$rest"; else echo "$top/$tgt/$rest"; fi
}

# the source_sha a translation was made from; nothing for an original
stored_sha() {
    if has_front_matter "$1"; then
        yq --front-matter=extract '.source_sha // ""' "$1"
    else
        sed -n 's/^<!--[[:space:]]*source_sha:[[:space:]]*\([0-9a-f]*\)[[:space:]]*-->.*/\1/p' "$1" | head -n 1
    fi
}

# same hash as the Python translator that wrote the existing translations
sha_of() { python3 -c 'import hashlib, sys; print(hashlib.sha256(open(sys.argv[1], encoding="utf-8").read().encode()).hexdigest()[:16])' "$1"; }

# partials the file pulls in (include_relative, right_content/left_content/toc), to be
# translated with it
partials() {
    local dir ref
    dir=$(dirname "$1")
    {
        grep -o 'include_relative[[:space:]]\+[^[:space:]%]\+' "$1" | awk '{ print $2 }' || true
        if has_front_matter "$1"; then
            yq --front-matter=extract '[.right_content, .left_content, .toc][] | select(type == "!!str" and test("\.md$"))' "$1"
        fi
    } | while read -r ref; do
        if [[ -f $dir/$ref ]]; then realpath --relative-to="$root" "$dir/$ref"; fi
    done | sort -u
}

flag_review() {
    if has_front_matter "$1"; then
        yq -i --front-matter=process '.translation_review = true' "$1"
    else
        sed -i '1a <!-- translation_review -->' "$1"
    fi
}

done_=() review=() skipped=() failed=()
for ((i = 0; i < ${#files[@]}; i++)); do
    src=${files[i]}
    if [[ -n $(stored_sha "$src") ]]; then
        echo "! $src has source_sha: it is a translation, translate its source instead"
        skipped+=("$src")
        continue
    fi
    if has_front_matter "$src" && [[ $(yq --front-matter=extract '.localize // false' "$src") == true ]]; then
        echo "! $src has localize: true: _plugins/i18n.rb builds it in every language (title in page_translations of _data/locales/<lang>.yml), skipped"
        skipped+=("$src")
        continue
    fi
    src_lang=$(lang_folder "$src")
    if [[ -z $src_lang ]]; then
        src_lang=$default
        declared=""
        has_front_matter "$src" && declared=$(yq --front-matter=extract '.lang // ""' "$src")
        if [[ -n $declared && $declared != "$default" ]]; then
            is_lang "$declared" || { echo "! $src: lang '$declared' is not in languages, skipped"; skipped+=("$src"); continue; }
            moved=${src%%/*}/$declared/${src#*/}
            echo "~ $src has lang: $declared, moving it to $moved"
            if (( ! dry )); then
                mkdir -p "$(dirname "$moved")"
                git mv "$src" "$moved"
                src=$moved
            fi
            src_lang=$declared
        fi
    fi
    while read -r p; do
        [[ -z $p || " ${files[*]} " == *" $p "* ]] && continue
        echo "+ $p, included by $src"
        files+=("$p")
    done < <(partials "$src")

    sha=$(sha_of "$src")
    for tgt in "${langs[@]}"; do
        [[ $tgt == "$src_lang" || ( -n $only && $tgt != "$only" ) ]] && continue
        dst=$(target_path "$src" "$tgt")
        if [[ -f $dst ]]; then
            stored=$(stored_sha "$dst")
            if [[ -z $stored ]]; then
                echo "= $dst has no source_sha: it is an original, skipped"
                skipped+=("$dst")
                continue
            fi
            if [[ $stored == "$sha" ]] && (( ! force )); then
                echo "= $dst is up to date"
                skipped+=("$dst")
                continue
            fi
        fi
        echo "> $src -> $dst ($src_lang -> $tgt, ${TRANSLATE_ADAPTER:-openrouter})"
        (( dry )) && continue

        start=$SECONDS
        "$i18n/prep" "$tgt" < "$src" > "$tmp/in"
        if ! "$adapter" "$src_lang" "$tgt" < "$tmp/in" > "$tmp/reply"; then
            echo "  failed: nothing written"
            failed+=("$dst")
            continue
        fi
        "$i18n/clean" < "$tmp/reply" > "$tmp/out"
        if ! warnings=$("$i18n/assemble" "$src_lang" "$src" "$tmp/out" "$sha" 2>&1 > "$tmp/final"); then
            echo "  assemble failed: $warnings"
            failed+=("$dst")
            continue
        fi
        problems=$("$i18n/check" "$tmp/in" "$tmp/final") || true
        problems=$(printf '%s\n%s\n' "$warnings" "$problems" | sed '/^$/d')
        if [[ -n $problems ]]; then
            flag_review "$tmp/final"
            sed 's/^/  ! /' <<<"$problems"
            review+=("$dst")
        else
            done_+=("$dst")
        fi
        mkdir -p "$(dirname "$dst")"
        mv "$tmp/final" "$dst"
        echo "  written in $((SECONDS - start)) s"
    done
done

echo
echo "translated ${#done_[@]}, to review ${#review[@]}, skipped ${#skipped[@]}, failed ${#failed[@]}"
for f in "${review[@]}"; do echo "  to review (translation_review: true): $f"; done
for f in "${failed[@]}"; do echo "  failed: $f"; done
(( ${#failed[@]} == 0 ))
